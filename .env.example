# Server-side only: where the Express API lives. Next.js proxies /api/* to it (see next.config.mjs).
# Local:       http://localhost:5000
# Production:  https://your-api.onrender.com
BACKEND_URL=http://localhost:5000
# BACKEND_URL=https://doctor-tracker-backend-sigma.vercel.app

# Optional: shows a "Demo access" card on the login page so reviewers can sign in with one click.
# (These are public by design - only use throw-away demo credentials.)
NEXT_PUBLIC_DEMO_EMAIL=admin@example.com
NEXT_PUBLIC_DEMO_PASSWORD=password123!
